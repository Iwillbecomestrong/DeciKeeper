<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset android:insetLeft="6dp" android:insetTop="4dp" android:insetRight="6dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/zzAccentSofter" />
                <corners android:radius="14dp" />
            </shape>
        </inset>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@android:color/transparent" /></shape>
    </item>
</selector>
