<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="闹钟时间"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/zzText"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_zz_card"
                android:padding="8dp">

                <TimePicker
                    android:id="@+id/tp_alarm_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="重复周期"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/zzText"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_zz_card"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox android:id="@+id/cb_day_mon" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="一" android:textColor="?attr/zzText" />
                    <CheckBox android:id="@+id/cb_day_tue" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="二" android:textColor="?attr/zzText" />
                    <CheckBox android:id="@+id/cb_day_wed" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="三" android:textColor="?attr/zzText" />
                    <CheckBox android:id="@+id/cb_day_thu" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="四" android:textColor="?attr/zzText" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox android:id="@+id/cb_day_fri" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="五" android:textColor="?attr/zzText" />
                    <CheckBox android:id="@+id/cb_day_sat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="六" android:textColor="?attr/zzText" />
                    <CheckBox android:id="@+id/cb_day_sun" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="日" android:textColor="?attr/zzText" />
                    <Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="解锁流程"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/zzText"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="双阶段时，两关分别自由组合挑战；同一关内通过任意一种即可。"
                android:textSize="12sp"
                android:textColor="?attr/zzMuted"
                android:layout_marginBottom="7dp" />

            <RadioGroup
                android:id="@+id/rg_unlock_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_zz_card"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/rb_unlock_single"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="单次"
                    android:textSize="13sp"
                    android:textColor="?attr/zzText" />

                <RadioButton
                    android:id="@+id/rb_unlock_two_stage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="双阶段"
                    android:textSize="13sp"
                    android:textColor="?attr/zzText" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/layout_stage1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_zz_card"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tv_stage1_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="第一关 · 通过其一即可"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/zzText"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <CheckBox android:id="@+id/cb_s1_qr" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="扫码" android:checked="true" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                    <CheckBox android:id="@+id/cb_s1_math" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="数学" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                    <CheckBox android:id="@+id/cb_s1_poem" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="诗词" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                    <CheckBox android:id="@+id/cb_s1_word" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="单词" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <CheckBox android:id="@+id/cb_s1_cloze" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="选词" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                    <CheckBox android:id="@+id/cb_s1_custom" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="自定义" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                    <Space android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_s1_custom_banks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 第一关防回床倒计时缓冲（双阶段模式下可见） -->
            <LinearLayout
                android:id="@+id/layout_stage1_cooldown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/zzSurface2"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tv_cooldown_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="防回床缓冲倒计时"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/zzText" />

                <TextView
                    android:id="@+id/tv_cooldown_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="第一关离床完成后立即将响铃震动降为最微弱模式，倒计时结束后进入第二关（0=立即进入）"
                    android:textSize="12sp"
                    android:textColor="?attr/zzMuted"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/et_stage_cooldown"
                        android:layout_width="72dp"
                        android:layout_height="38dp"
                        android:inputType="number"
                        android:text="0"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:textColor="?attr/zzText"
                        android:background="@drawable/bg_input_field" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" 秒"
                        android:textSize="13sp"
                        android:textColor="?attr/zzMuted"
                        android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_stage2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/zzSurface2"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tv_stage2_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="第二关 · 通过其一即可"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/zzText"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <CheckBox android:id="@+id/cb_s2_qr" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="扫码" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                    <CheckBox android:id="@+id/cb_s2_math" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="数学" android:checked="true" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                    <CheckBox android:id="@+id/cb_s2_poem" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="诗词" android:checked="true" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                    <CheckBox android:id="@+id/cb_s2_word" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="单词" android:checked="true" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <CheckBox android:id="@+id/cb_s2_cloze" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="选词" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                    <CheckBox android:id="@+id/cb_s2_custom" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="自定义" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                    <Space android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_s2_custom_banks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="挑战数量"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/zzText"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_zz_card"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="7dp">

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="数学 " android:textSize="13sp" android:textColor="?attr/zzText" />
                        <EditText android:id="@+id/et_math_count" android:layout_width="52dp" android:layout_height="38dp" android:inputType="number" android:text="2" android:gravity="center" android:textSize="13sp" android:textColor="?attr/zzText" android:background="@drawable/bg_input_field" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 道" android:textSize="12sp" android:textColor="?attr/zzMuted" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginStart="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="诗词 " android:textSize="13sp" android:textColor="?attr/zzText" />
                        <EditText android:id="@+id/et_poem_count" android:layout_width="52dp" android:layout_height="38dp" android:inputType="number" android:text="3" android:gravity="center" android:textSize="13sp" android:textColor="?attr/zzText" android:background="@drawable/bg_input_field" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 句" android:textSize="12sp" android:textColor="?attr/zzMuted" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="7dp">

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="单词 " android:textSize="13sp" android:textColor="?attr/zzText" />
                        <EditText android:id="@+id/et_word_count" android:layout_width="52dp" android:layout_height="38dp" android:inputType="number" android:text="10" android:gravity="center" android:textSize="13sp" android:textColor="?attr/zzText" android:background="@drawable/bg_input_field" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 个" android:textSize="12sp" android:textColor="?attr/zzMuted" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginStart="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="选词 " android:textSize="13sp" android:textColor="?attr/zzText" />
                        <EditText android:id="@+id/et_cloze_count" android:layout_width="52dp" android:layout_height="38dp" android:inputType="number" android:text="5" android:gravity="center" android:textSize="13sp" android:textColor="?attr/zzText" android:background="@drawable/bg_input_field" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 道" android:textSize="12sp" android:textColor="?attr/zzMuted" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="题库 " android:textSize="13sp" android:textColor="?attr/zzText" />
                        <EditText android:id="@+id/et_custom_count" android:layout_width="52dp" android:layout_height="38dp" android:inputType="number" android:text="3" android:gravity="center" android:textSize="13sp" android:textColor="?attr/zzText" android:background="@drawable/bg_input_field" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 道" android:textSize="12sp" android:textColor="?attr/zzMuted" />
                    </LinearLayout>

                    <Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
