<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_ringtone_picker"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/zzPageBg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 顶部标题栏与当前选中标牌 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/zzSurface"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="←"
                android:textColor="?attr/zzText"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_title_main"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="闹钟提示音"
                android:textColor="?attr/zzText"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="支持选择系统内置铃声或导入手机存储的自定义音频。"
            android:textColor="?attr/zzMuted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_current_selected_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_zz_pill"
            android:backgroundTint="?attr/zzAccentSofter"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:text="当前选中：系统默认闹钟"
            android:textColor="?attr/zzAccentStrong"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 顶部 Tab 分段选择器（保留充裕留白与圆角胶囊风格） -->
    <LinearLayout
        android:id="@+id/layout_tab_container"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_zz_pill"
        android:backgroundTint="?attr/zzSurface2"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/tv_system_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_zz_pill"
            android:backgroundTint="?attr/zzAccent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="系统自带"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_custom_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_zz_pill"
            android:backgroundTint="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="自己导入"
            android:textColor="?attr/zzMuted"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 主体列表内容区域（全宽卡片，左右各留 16dp 留白） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingBottom="6dp">

        <!-- 页面 1：系统自带铃声（全宽展示，带搜索框） -->
        <LinearLayout
            android:id="@+id/layout_system_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_zz_card"
            android:backgroundTint="?attr/zzSurface"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <EditText
                android:id="@+id/et_search_system"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_input_field"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="8dp"
                android:hint="搜索系统铃声"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textColor="?attr/zzText"
                android:textColorHint="?attr/zzSubtle"
                android:textSize="13sp" />

            <ListView
                android:id="@+id/list_system_ringtones"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:divider="?attr/zzLine"
                android:dividerHeight="0.5dp"
                android:paddingBottom="6dp" />
        </LinearLayout>

        <!-- 页面 2：自己导入音频（全宽展示，长名称完整展开） -->
        <LinearLayout
            android:id="@+id/layout_custom_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_zz_card"
            android:backgroundTint="?attr/zzSurface"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_import_custom"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_zz_pill"
                android:backgroundTint="?attr/zzAccentSofter"
                android:text="+ 导入本地音频文件"
                android:textAllCaps="false"
                android:textColor="?attr/zzAccentStrong"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_empty_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingVertical="40dp"
                android:text="暂无导入的本地音频\n点击上方按钮可从手机存储选取音乐或提示音"
                android:textColor="?attr/zzMuted"
                android:textSize="13sp"
                android:visibility="gone" />

            <ListView
                android:id="@+id/list_custom_ringtones"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:divider="?attr/zzLine"
                android:dividerHeight="0.5dp"
                android:paddingBottom="6dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 底部固定吸底操作栏（带四周优雅留白与胶囊按钮） -->
    <LinearLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/zzSurface"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_stop_preview"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_zz_pill"
            android:backgroundTint="?attr/zzSurface2"
            android:paddingHorizontal="14dp"
            android:text="停止试听"
            android:textAllCaps="false"
            android:textColor="?attr/zzText"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_save_ringtone"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_zz_pill"
            android:backgroundTint="?attr/zzAccent"
            android:paddingHorizontal="16dp"
            android:text="确定使用该铃声"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
