<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_ringtone_picker"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/zzPageBg"
    android:orientation="vertical">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/zzSurface"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="←"
                android:textColor="?attr/zzText"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_title_main"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="闹钟提示音"
                android:textColor="?attr/zzText"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="左侧为系统自带铃声，右侧为自己导入的本地音频。"
            android:textColor="?attr/zzMuted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_current_selected_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_zz_pill"
            android:backgroundTint="?attr/zzAccentSofter"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="当前选中：系统默认闹钟"
            android:textColor="?attr/zzAccentStrong"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 左右分栏主体 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/zzLine"
        android:orientation="horizontal"
        android:paddingTop="1dp">

        <!-- 左栏：系统自带 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="0.5dp"
            android:layout_weight="1"
            android:background="?attr/zzSurface"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_system_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/zzSurface2"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:text="系统自带"
                android:textColor="?attr/zzText"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_search_system"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_input_field"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="6dp"
                android:hint="搜索系统铃声"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:textColor="?attr/zzText"
                android:textColorHint="?attr/zzSubtle"
                android:textSize="11sp" />

            <ListView
                android:id="@+id/list_system_ringtones"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:divider="@null"
                android:dividerHeight="2dp"
                android:paddingBottom="6dp" />
        </LinearLayout>

        <!-- 右栏：自己导入 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="0.5dp"
            android:layout_weight="1"
            android:background="?attr/zzSurface"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_custom_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/zzAccentSofter"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:text="自己导入"
                android:textColor="?attr/zzAccentStrong"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_import_custom"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                android:backgroundTint="?attr/zzAccentSofter"
                android:text="+ 导入本地音频"
                android:textAllCaps="false"
                android:textColor="?attr/zzAccentStrong"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_empty_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="24dp"
                android:text="暂无导入音频\n点击上方按钮从手机存储导入"
                android:textColor="?attr/zzMuted"
                android:textSize="11sp"
                android:visibility="gone" />

            <ListView
                android:id="@+id/list_custom_ringtones"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:divider="@null"
                android:dividerHeight="2dp"
                android:paddingBottom="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部操作栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/zzSurface"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btn_stop_preview"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="?attr/zzSurface2"
            android:text="停止试听"
            android:textAllCaps="false"
            android:textColor="?attr/zzText"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_save_ringtone"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="?attr/zzAccent"
            android:text="确定使用该铃声"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
