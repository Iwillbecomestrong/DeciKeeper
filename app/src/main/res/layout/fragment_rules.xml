<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_rules"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/zzPageBg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="96dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textColor="?attr/zzText"
            android:textSize="26sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:text="规则、外观、守护与备份。"
            android:textColor="?attr/zzMuted"
            android:textSize="13sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/zzSurface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:onClick="showThemePicker"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="主题" android:textColor="?attr/zzText" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="四季视觉系统" android:textColor="?attr/zzMuted" android:textSize="11sp" />
                </LinearLayout>
                <com.decikeeper.app.ui.ThemeSummaryView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/zzAccentStrong" android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 每日生效时间 (刷新时间) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_refresh_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/zzSurface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="每日生效时间"
                            android:textColor="?attr/zzText"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="规则额度重置与生效结算时刻 (04:00 - 12:00)"
                            android:textColor="?attr/zzMuted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_refresh_time_value_rules"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_zz_pill"
                        android:backgroundTint="?attr/zzAccentSoft"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="08:00"
                        android:textColor="?attr/zzAccentStrong"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="自动同步勿扰结束时间"
                            android:textColor="?attr/zzText"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_refresh_sync_hint_rules"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="跟随 04:00~12:00 内最早结束的勿扰时段"
                            android:textColor="?attr/zzMuted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_refresh_sync_rules"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="?attr/zzAccent" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 可修改时段（除闹钟） -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_edit_window_policy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/zzSurface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="可修改时段（除闹钟）"
                        android:textColor="?attr/zzText"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="控制除闹钟外的各项规则与保护功能在一天内的可修改时间范围。"
                        android:textColor="?attr/zzMuted"
                        android:textSize="11sp" />
                </LinearLayout>

                <RadioGroup
                    android:id="@+id/rg_settings_edit_window_policy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_settings_edit_window_all_day"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="?attr/zzAccent"
                        android:paddingVertical="4dp"
                        android:text="「全天可修改」（默认）\n全天任意时刻均可修改规则与保护功能"
                        android:textColor="?attr/zzText"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rb_settings_edit_window_effective_to_midnight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="?attr/zzAccent"
                        android:paddingVertical="4dp"
                        android:text="「仅生效时间至 24:00 可修改」\n00:00 至每日生效时间期间除闹钟外锁定为只读"
                        android:textColor="?attr/zzText"
                        android:textSize="13sp" />
                </RadioGroup>

                <TextView
                    android:id="@+id/tv_settings_lockout_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?attr/zzAccentStrong"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_settings_edit_window_pending"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/zzAccent"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/zzSurface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="无障碍服务" android:textColor="?attr/zzText" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_accessibility_status_main" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="?attr/zzMuted" android:textSize="11sp" />
                </LinearLayout>
                <Switch android:id="@+id/switch_accessibility_service" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="?attr/zzAccent" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/zzSurface3"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_protection_section_title"
                        android:textColor="?attr/zzText"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/btn_protection_section_help"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_zz_help_pill"
                        android:backgroundTint="?attr/zzSurface2"
                        android:clickable="true"
                        android:contentDescription="加强约束功能说明"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="?"
                        android:textColor="?attr/zzMuted"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/settings_protection_section_summary"
                    android:textColor="?attr/zzMuted"
                    android:textSize="11sp" />

                <!-- 1. 闹钟防关机保护 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_protection_alarm_title" android:textColor="?attr/zzText" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_alarm_power_off_status_main" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="?attr/zzMuted" android:textSize="11sp" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_alarm_power_off_protection" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/zzLine" />

                <!-- 2. 桌面守护小浮窗 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="桌面守护小浮窗" android:textColor="?attr/zzText" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_floating_guard_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="?attr/zzMuted" android:textSize="11sp" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_floating_guard" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/zzLine" />

                <!-- 3. 小窗可见性增强 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_protection_floating_title" android:textColor="?attr/zzText" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_floating_window_protection_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="?attr/zzMuted" android:textSize="11sp" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_floating_window_protection" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                <View android:id="@+id/divider_privacy_space_guard" android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/zzLine" />

                <!-- 4. 隐私空间保护 (vivo / iQOO 专享) -->
                <LinearLayout android:id="@+id/layout_privacy_space_guard" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_protection_privacy_title" android:textColor="?attr/zzText" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_privacy_space_guard_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="?attr/zzMuted" android:textSize="11sp" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_privacy_space_guard" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/zzLine" />

                <!-- 5. 防卸载与防关权限保护 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_protection_uninstall_perm_title" android:textColor="?attr/zzText" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_uninstall_and_perm_protection_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="?attr/zzMuted" android:textSize="11sp" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_uninstall_and_perm_protection" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                <View android:id="@+id/divider_device_admin" android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/zzLine" android:visibility="gone" />

                <!-- 6. 设备管理器防卸载锁 (OPPO / ColorOS 专享) -->
                <LinearLayout android:id="@+id/layout_device_admin_protection" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="8dp" android:visibility="gone">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="设备管理器防卸载锁" android:textColor="?attr/zzText" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_device_admin_protection_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="?attr/zzMuted" android:textSize="11sp" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_device_admin_protection" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/zzSurface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">
            <Button
                android:id="@+id/btn_quick_send_logs"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="start|center_vertical"
                android:textAlignment="viewStart"
                android:paddingStart="16dp"
                android:paddingLeft="16dp"
                android:paddingEnd="16dp"
                android:paddingRight="16dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="导出日志"
                android:textAllCaps="false"
                android:textColor="?attr/zzText"
                android:textSize="14sp" />
        </androidx.cardview.widget.CardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
            <Button android:id="@+id/btn_export_settings" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:backgroundTint="?attr/zzSurface2" android:text="导出配置" android:textAllCaps="false" android:textColor="?attr/zzText" />
            <Button android:id="@+id/btn_import_settings" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="5dp" android:backgroundTint="?attr/zzSurface2" android:text="导入配置" android:textAllCaps="false" android:textColor="?attr/zzText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btn_open_help"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:backgroundTint="?attr/zzSurface2"
                android:text="使用说明"
                android:textAllCaps="false"
                android:textColor="?attr/zzText"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_open_about"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:backgroundTint="?attr/zzAccentSoft"
                android:text="关于我们"
                android:textAllCaps="false"
                android:textColor="?attr/zzAccentStrong"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/card_weekly_privilege"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/zzSurface" />
    </LinearLayout>
</ScrollView>
