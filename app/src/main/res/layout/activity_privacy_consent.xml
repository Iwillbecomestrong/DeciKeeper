<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/zzPageBg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- 顶部标题 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="决定守护"
                android:textColor="?attr/zzAccentStrong"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="欢迎使用决定守护 · 纯单机决定保护软件"
                android:textColor="?attr/zzMuted"
                android:textSize="13sp" />

            <!-- 核心服务说明与隐私承诺卡片（精简有力，一目了然） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_zz_card"
                android:backgroundTint="?attr/zzSurface"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="决定守护是一款纯单机决定保护软件"
                    android:textColor="?attr/zzText"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- 要点 1：单机无网 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="●"
                        android:textColor="?attr/zzAccent"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="纯单机离线运行：未申请网络权限，物理断网，绝不收集、不出境、不上报任何个人隐私数据。"
                        android:textColor="?attr/zzText"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 要点 2：本地沙箱 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="●"
                        android:textColor="?attr/zzAccent"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="数据完全归你所有：所有时间规则、闹钟设置与诊断日志均保存在本机沙箱，支持自由导入导出。"
                        android:textColor="?attr/zzText"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 要点 3：权限克制 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="●"
                        android:textColor="?attr/zzAccent"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="权限透明最小化：基础功能仅需通知与悬浮窗，高级保护按需开启，无第三方广告与追踪SDK。"
                        android:textColor="?attr/zzText"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 协议与隐私政策入口区域（卡片化，带书名号，清晰完整） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_zz_card_soft"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="请在使用前仔细阅读并充分理解："
                    android:textColor="?attr/zzMuted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_open_user_agreement"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_zz_card"
                        android:gravity="center"
                        android:text="《用户协议》 ↗"
                        android:textColor="?attr/zzAccentStrong"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/tv_open_privacy_policy"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_zz_card"
                        android:gravity="center"
                        android:text="《隐私政策》 ↗"
                        android:textColor="?attr/zzAccentStrong"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 底部操作按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_consent_accept"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="?attr/zzAccent"
            android:text="同意并进入决定守护"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_consent_decline"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="?attr/zzSurface2"
            android:text="暂不同意并退出"
            android:textAllCaps="false"
            android:textColor="?attr/zzMuted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="纯单机守护 · 保护清醒时的每一次决定"
            android:textColor="?attr/zzSubtle"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
