<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/zzPageBg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="24dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="决定守护"
                android:textColor="?attr/zzAccentStrong"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="欢迎使用决定守护"
                android:textColor="?attr/zzText"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_zz_card"
                android:backgroundTint="?attr/zzSurface"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="决定守护是一款纯单机决定保护软件，不收集任何个人数据。"
                    android:textColor="?attr/zzText"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="它不替用户决定什么事情值得做；它保护的是：用户清醒时，为未来做出的决定。\n\n很多时候，人并不是不知道正确方向。问题在于：当决定真正需要执行的时候，状态已经发生变化。晚上认真做出的「今天早点睡」，常常败给下一刻的「再刷一个视频」。决定守护关注的，就是这种已经做出决定、但执行时容易被当前状态改变的时刻。\n\n决定守护不做包罗万象的泛自律，守护范围严格局限在两处最容易被冲动和生理状态击穿的现实边界：\n1. 受手机影响的使用边界（该停的时候停下来）：防范短视频、游戏、聊天和信息流对学习、工作与睡眠的无节制侵占；\n2. 早晨起床的行动边界（该起的时候起来）：击破清晨半梦半醒时的赖床惯性，推动真正离开床铺并完成清醒过渡。\n\n应用纯单机运行，不申请联网权限，所有规则均保存在本地。基础使用仅需通知与悬浮窗等基础权限，高级保护可按需开启。"
                    android:textColor="?attr/zzMuted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_open_user_agreement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="8dp"
                    android:text="用户协议"
                    android:textColor="?attr/zzAccentStrong"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_open_privacy_policy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="8dp"
                    android:text="隐私政策"
                    android:textColor="?attr/zzAccentStrong"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_consent_accept"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="?attr/zzAccent"
            android:text="同意并进入决定守护"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_consent_decline"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="?attr/zzSurface2"
            android:text="暂不同意并退出"
            android:textAllCaps="false"
            android:textColor="?attr/zzMuted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="权限说明可在进入决定守护后逐项查看。"
            android:textColor="?attr/zzSubtle"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
