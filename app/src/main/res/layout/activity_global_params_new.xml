<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_global_params"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/zzPageBg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="18dp"
    android:paddingTop="0dp"
    android:paddingEnd="18dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="72dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="规则参数" android:textColor="?attr/zzText" android:textSize="26sp" android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:id="@+id/card_pending_changes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/zzWarningSoft"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView android:id="@+id/tv_lockout_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="当前处于设置锁定时段，仅供查看。" android:textColor="?attr/zzWarning" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_pending_changes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="?attr/zzMuted" android:textSize="11sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/zzSurface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="次周生效 · 每周特权" android:textColor="?attr/zzText" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:layout_marginBottom="14dp" android:text="利好立即生效；增加可用次数或时长等不利修改，下周生效。" android:textColor="?attr/zzMuted" android:textSize="11sp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="每周特权次数 ≤ 3" android:textColor="?attr/zzText" android:textSize="13sp" android:textStyle="bold" />
                <EditText android:id="@+id/et_weekly_privilege_limit" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:layout_marginBottom="14dp" android:background="@drawable/bg_input_field" android:hint="2" android:inputType="number" android:textColor="?attr/zzText" android:textColorHint="?attr/zzSubtle" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="每周特权总时长（分钟）≤ 600" android:textColor="?attr/zzText" android:textSize="13sp" android:textStyle="bold" />
                <EditText android:id="@+id/et_weekly_privilege_duration" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_input_field" android:hint="240" android:inputType="number" android:textColor="?attr/zzText" android:textColorHint="?attr/zzSubtle" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/zzSurface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="次日生效 · 核心规则" android:textColor="?attr/zzText" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:layout_marginBottom="14dp" android:text="利好立即生效；放宽约束的不利修改在次日生效。" android:textColor="?attr/zzMuted" android:textSize="11sp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="时间规则可修改时段" android:textColor="?attr/zzText" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="控制时间规则与参数在一天内的可编辑时间范围。" android:textColor="?attr/zzMuted" android:textSize="11sp" />
                <RadioGroup
                    android:id="@+id/rg_edit_window_policy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="14dp"
                    android:orientation="vertical">
                    <RadioButton
                        android:id="@+id/rb_edit_window_all_day"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="?attr/zzAccent"
                        android:paddingVertical="4dp"
                        android:text="「全天可修改」（默认）\n全天任意时刻均可修改时间规则与参数"
                        android:textColor="?attr/zzText"
                        android:textSize="13sp" />
                    <RadioButton
                        android:id="@+id/rb_edit_window_effective_to_midnight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="?attr/zzAccent"
                        android:paddingVertical="4dp"
                        android:text="「仅生效时间至 24:00 可修改」\n00:00 至每日生效时间期间锁定为只读"
                        android:textColor="?attr/zzText"
                        android:textSize="13sp" />
                </RadioGroup>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="特权可用时间范围" android:textColor="?attr/zzText" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="限制每周特权只能在指定时段内使用。" android:textColor="?attr/zzMuted" android:textSize="11sp" />
                <LinearLayout android:id="@+id/layout_privilege_window_inputs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:layout_marginBottom="14dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <EditText android:id="@+id/et_privilege_window_start" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:background="@drawable/bg_input_field" android:gravity="center" android:hint="07:00" android:inputType="time" android:textColor="?attr/zzText" android:textColorHint="?attr/zzSubtle" />
                    <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:gravity="center" android:text="—" android:textColor="?attr/zzSubtle" />
                    <EditText android:id="@+id/et_privilege_window_end" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:background="@drawable/bg_input_field" android:gravity="center" android:hint="23:59" android:inputType="time" android:textColor="?attr/zzText" android:textColorHint="?attr/zzSubtle" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="下阶段借用比例（%）" android:textColor="?attr/zzText" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="额度不足时，可从下一阶段借用的时间与次数比例。" android:textColor="?attr/zzMuted" android:textSize="11sp" />
                <EditText android:id="@+id/et_borrow_percentage" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:layout_marginBottom="14dp" android:background="@drawable/bg_input_field" android:hint="60" android:inputType="number" android:textColor="?attr/zzText" android:textColorHint="?attr/zzSubtle" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="临时使用受限应用时长上限（分钟）≤ 3.0" android:textColor="?attr/zzText" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="临时解锁单次可输入的最大时长。" android:textColor="?attr/zzMuted" android:textSize="11sp" />
                <EditText android:id="@+id/et_temp_restricted_access_max_seconds" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:layout_marginBottom="14dp" android:background="@drawable/bg_input_field" android:hint="0.5" android:inputType="numberDecimal" android:textColor="?attr/zzText" android:textColorHint="?attr/zzSubtle" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="空档冷却（秒）" android:textColor="?attr/zzText" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="从空档期归来后的冷静时间。" android:textColor="?attr/zzMuted" android:textSize="11sp" />
                <EditText android:id="@+id/et_cool_down_gap" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:layout_marginBottom="14dp" android:background="@drawable/bg_input_field" android:hint="300" android:inputType="number" android:textColor="?attr/zzText" android:textColorHint="?attr/zzSubtle" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="统一冷却（秒）" android:textColor="?attr/zzText" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="休息结束与临时解锁结束后，共用这一冷却时间。" android:textColor="?attr/zzMuted" android:textSize="11sp" />
                <EditText android:id="@+id/et_cool_down_rest" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_input_field" android:hint="60" android:inputType="number" android:textColor="?attr/zzText" android:textColorHint="?attr/zzSubtle" />

                <EditText android:id="@+id/et_cool_down_blacklist" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/zzSurface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="立即生效 · 预警设置" android:textColor="?attr/zzText" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:layout_marginBottom="14dp" android:text="提醒类参数立即生效，不需要等待次日刷新。" android:textColor="?attr/zzMuted" android:textSize="11sp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="每日生效时间" android:textColor="?attr/zzText" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="范围 04:00 ~ 12:00，且须位于空档期或勿扰时段边界。" android:textColor="?attr/zzMuted" android:textSize="11sp" />
                <EditText android:id="@+id/et_refresh_time" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_input_field" android:hint="08:00" android:inputType="time" android:textColor="?attr/zzText" android:textColorHint="?attr/zzSubtle" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_refresh_sync" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="跟随最早结束时段（自动同步）" android:textColor="?attr/zzText" android:textSize="12sp" />
                <TextView android:id="@+id/tv_refresh_sync_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:layout_marginBottom="14dp" android:text="开启后自动同步；窗口内无匹配时段时默认 08:00" android:textColor="?attr/zzMuted" android:textSize="10sp" android:visibility="gone" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="监管远期预警（分钟）" android:textColor="?attr/zzText" android:textSize="13sp" android:textStyle="bold" />
                <EditText android:id="@+id/et_notify_entry_far" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:layout_marginBottom="14dp" android:background="@drawable/bg_input_field" android:hint="15" android:inputType="number" android:textColor="?attr/zzText" android:textColorHint="?attr/zzSubtle" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="监管近期预警（分钟）" android:textColor="?attr/zzText" android:textSize="13sp" android:textStyle="bold" />
                <EditText android:id="@+id/et_notify_entry_near" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_input_field" android:hint="5" android:inputType="number" android:textColor="?attr/zzText" android:textColorHint="?attr/zzSubtle" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="?attr/zzAccent"
            android:text="保存设置"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
