<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F4"
    android:keepScreenOn="true">

    <View
        android:id="@+id/view_status_bar_pull_zone"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="238dp">

        <LinearLayout
            android:id="@+id/layout_background_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="52dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/tv_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#2F4034"
                android:textSize="27sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:gravity="center"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_sub_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:textColor="#5F6E64"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:paddingHorizontal="10dp" />

            <LinearLayout
                android:id="@+id/layout_quota_bubble"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#FFFFFF"
                android:elevation="1dp"
                android:padding="10dp">

                <LinearLayout
                    android:id="@+id/layout_current_segment_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#F7F9F7"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="16dp">

                    <TextView
                        android:id="@+id/tv_current_segment_range"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="本阶段 (08:00 - 12:00)"
                        android:textColor="#5F7566"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="时长"
                                android:textColor="#7D8981"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_stat_time_big"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="--"
                                android:textColor="#233128"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:singleLine="true"
                                android:maxLines="1"
                                android:includeFontPadding="false" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="42dp"
                            android:background="#DDE3DE" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="次数"
                                android:textColor="#7D8981"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_usable_count_big"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="--"
                                android:textColor="#233128"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:singleLine="true"
                                android:maxLines="1"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_stat_time_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="(额度--/--)"
                        android:textColor="#7D8981"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_surplus_borrow_line"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text=""
                        android:textColor="#68866F"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="3dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_rest_countdown_in_card"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text=""
                        android:textColor="#68866F"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_next_segment_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#EEF2EE"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="13dp"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tv_next_segment_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="下一阶段: 计算中..."
                        android:textColor="#66736A"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:textAlignment="center" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_penalty_hit_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#B45B4D"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="gone"
                android:background="#FFF1EE"
                android:paddingVertical="8dp"
                android:paddingHorizontal="14dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layout_bottom_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#F5F7F4"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btn_back_to_home"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="回到桌面"
            android:textAllCaps="false"
            android:textColor="#405047"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#E2E8E3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_temporary_access"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="临时解锁"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#849B89"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_temporary_access_help"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="#E2E8E3"
                android:contentDescription="临时使用说明"
                android:src="@android:drawable/ic_menu_help"
                android:tint="#607066"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_temporary_access_quick_10"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:backgroundTint="#C28765"
            android:text="冷却中应急 10 秒"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_emergency"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:backgroundTint="#78917D"
            android:text="申请休息"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_weekly_privilege"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#B79A69"
            android:text="每周特权"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/view_penalty_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_penalty_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#27342B"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <Button
                android:id="@+id/btn_penalty_ok"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:text="确认"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#78917D" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/view_borrow_confirm_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="31dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_borrow_confirm_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="借用额度确认"
                android:textColor="#A45B45"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tv_borrow_confirm_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#344139"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <Button
                android:id="@+id/btn_borrow_confirm_ok"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:text="确认借用"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#B46F57" />

            <Button
                android:id="@+id/btn_borrow_confirm_cancel"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:text="取消"
                android:textAllCaps="false"
                android:textColor="#415047"
                android:backgroundTint="#E5EAE6" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layout_emergency_options"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#F5F7F4"
        android:padding="24dp"
        android:visibility="gone"
        android:elevation="20dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="申请休息 / 额度管理"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#233128"
            android:gravity="center"
            android:layout_marginBottom="18dp" />

        <TextView
            android:id="@+id/tv_quota_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="当前可用: 0min / 0次 | 可借用: 0min / 0次"
            android:textSize="14sp"
            android:textColor="#4B5A50"
            android:gravity="center"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_cooling_penalty_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="冷静期内申请将消耗双倍额度和次数"
            android:textSize="13sp"
            android:textColor="#B45B4D"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="输入申请时长（分钟）"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#A8B6AA"
            android:layout_marginBottom="20dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_calm_minutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:gravity="center"
                android:textColor="#233128"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_cancel_emergency"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="取消"
                android:textAllCaps="false"
                android:textColor="#415047"
                android:backgroundTint="#E5EAE6"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_confirm_calm"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="确认申请"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#78917D"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_stop_free_time_emergency"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="结束当前休息"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B76858"
            android:visibility="gone"
            android:layout_marginTop="12dp" />
    </LinearLayout>

</FrameLayout>
