<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sea_surface"
    android:keepScreenOn="true">

    <View
        android:id="@+id/view_status_bar_pull_zone"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true" />

    <!--
      页面名称: 锁屏拦截悬浮窗
      文件路径: app/src/main/res/layout/window_lock_screen.xml
      描述:
      - 核心拦截界面，覆盖全屏
      - 包含:
        - 顶部左上角: 隐藏的 "Secret Door" (5次点击出口)
        - 中央: 倒计时 / 警报信息
        - 中央下部: 休息时间申请区域 (输入分钟数)
        - 底部: "临时使用受限应用" 按钮
        - 覆盖层: 点击"打开"后弹出的应用网格面板 (GridLayout)
    -->

    <LinearLayout
        android:id="@+id/layout_background_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="180dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <!-- Removed Deep Sea Alarm per user request -->


        <TextView
            android:id="@+id/tv_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#1976D2"
            android:textSize="28sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tv_sub_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            android:textColor="#80DEEA"
            android:textSize="14sp"
            android:paddingHorizontal="20dp"
            android:gravity="center"
            android:letterSpacing="0.05"/>

                <!-- 大容器框 — 包住当前段和下一段两张卡片 -->
                <LinearLayout
                    android:id="@+id/layout_quota_bubble"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="10dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_sea_bubble"
                    android:backgroundTint="@color/sea_card_mid"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="0dp">

                    <!-- 📊 当前段卡片 -->
                    <LinearLayout
                        android:id="@+id/layout_current_segment_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_sea_bubble"
                        android:backgroundTint="#0DFFFFFF"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="16dp"
                        android:layout_margin="12dp"
                        android:layout_marginBottom="6dp">

                        <!-- Segment range title -->
                        <TextView
                            android:id="@+id/tv_current_segment_range"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="本阶段 (08:00 - 12:00)"
                            android:textColor="#80DEEA"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginBottom="14dp"/>

                        <!-- Dual column numbers -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_marginBottom="4dp">

                            <!-- Rest time column -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="时长"
                                    android:textColor="#CCCCCC"
                                    android:textSize="10sp"
                                    android:layout_marginBottom="2dp"/>

                                <TextView
                                    android:id="@+id/tv_stat_time_big"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textColor="#FFFFFF"
                                    android:textSize="28sp"
                                    android:textStyle="bold"
                                    android:fontFamily="monospace"
                                    android:singleLine="true"
                                    android:maxLines="1"
                                    android:ellipsize="none"
                                    android:includeFontPadding="false"/>
                            </LinearLayout>

                            <!-- Separator -->
                            <View
                                android:layout_width="1dp"
                                android:layout_height="40dp"
                                android:background="#15FFFFFF"/>

                            <!-- Unlock count column -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="次数"
                                    android:textColor="#CCCCCC"
                                    android:textSize="10sp"
                                    android:layout_marginBottom="2dp"/>

                                <TextView
                                    android:id="@+id/tv_usable_count_big"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textColor="#FFFFFF"
                                    android:textSize="28sp"
                                    android:textStyle="bold"
                                    android:fontFamily="monospace"
                                    android:singleLine="true"
                                    android:maxLines="1"
                                    android:ellipsize="none"
                                    android:includeFontPadding="false"/>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Detail row -->
                        <TextView
                            android:id="@+id/tv_stat_time_detail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="(额度--/--)"
                            android:textColor="#B0B0B0"
                            android:textSize="10sp"
                            android:layout_marginTop="4dp"
                            android:alpha="0.8"/>

                        <!-- Surplus/borrow row (conditionally shown, default gone) -->
                        <TextView
                            android:id="@+id/tv_surplus_borrow_line"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#81C784"
                            android:textSize="10sp"
                            android:gravity="center"
                            android:layout_marginTop="6dp"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="3dp"
                            android:visibility="gone"/>

                        <!-- Rest countdown row (conditionally shown, default gone) -->
                        <TextView
                            android:id="@+id/tv_rest_countdown_in_card"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#4CAF50"
                            android:textSize="10sp"
                            android:gravity="center"
                            android:layout_marginTop="4dp"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <!-- 下一段卡片（略淡，区分层级） -->
                    <LinearLayout
                        android:id="@+id/layout_next_segment_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_sea_bubble"
                        android:backgroundTint="@color/sea_card_light"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="14dp"
                        android:layout_marginHorizontal="12dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tv_next_segment_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="下一阶段: 计算中..."
                            android:textColor="#80CBC4"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:textAlignment="center"/>
                    </LinearLayout>

                </LinearLayout>



        <!-- Penalty warning bar (independent from cards, conditionally shown) -->
        <TextView
            android:id="@+id/tv_penalty_hit_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF5252"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="#1AFF5252"
            android:paddingVertical="6dp"
            android:paddingHorizontal="16dp"/>
        <!-- Settings matrix moved out to bottom stack -->



    </LinearLayout>

    <FrameLayout
        android:id="@+id/view_penalty_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_penalty_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#212121"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:background="#20000000" />

            <Button
                android:id="@+id/btn_penalty_ok"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="确认" />
        </LinearLayout>
    </FrameLayout>

    <!-- 临时解锁借用确认覆盖层（在锁屏内部，保证置顶） -->
    <FrameLayout
        android:id="@+id/view_borrow_confirm_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:orientation="vertical"
            android:layout_marginHorizontal="24dp">

            <TextView
                android:id="@+id/tv_borrow_confirm_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="超级临时 - 借用额度确认"
                android:textColor="#E64A19"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tv_borrow_confirm_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#212121"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:background="#20000000" />

            <Button
                android:id="@+id/btn_borrow_confirm_ok"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="确认"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF7043" />

            <Button
                android:id="@+id/btn_borrow_confirm_cancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="取消"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1976D2" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layout_emergency_options"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#DDFFFFFF"
        android:padding="24dp"
        android:visibility="gone"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="申请休息 / 额度管理"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tv_quota_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前可用: 0min / 0次 | 可借用: 0min / 0次"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="16dp" />
            
        <TextView
            android:id="@+id/tv_cooling_penalty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ 冷静期内申请将消耗双倍额度和次数！"
            android:textSize="14sp"
            android:textColor="#FF5252"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="输入申请时长 (分钟)"
            android:layout_marginBottom="24dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_calm_minutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_cancel_emergency"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="取消"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1976D2"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btn_confirm_calm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="确认申请"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF7043"
                android:layout_marginStart="12dp" />
        </LinearLayout>
        
        <Button
            android:id="@+id/btn_stop_free_time_emergency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="结束当前休息"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1976D2"
            android:visibility="gone"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_bottom_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btn_back_to_home"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="0dp"
            android:backgroundTint="#1976D2"
            android:text="🏠 回到桌面"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            app:strokeColor="#6090CAF9"
            app:strokeWidth="1dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_temporary_access"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="0dp"
                android:backgroundTint="#FF7043"
                android:text="超级临时使用受限应用(&lt;60s)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                app:cornerRadius="26dp" />

            <ImageButton
                android:id="@+id/btn_temporary_access_help"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:backgroundTint="#1AFFFFFF"
                android:contentDescription="临时使用说明"
                android:src="@android:drawable/ic_menu_help"
                android:tint="#B2EBF2"
                app:cornerRadius="22dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_temporary_access_quick_10"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="0dp"
            android:visibility="gone"
            android:backgroundTint="#E65100"
            android:text="冷却中应急 10 秒"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="24dp" />

        <Button
            android:id="@+id/btn_emergency"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:visibility="gone"
            android:backgroundTint="#FF7043"
            android:text="申请休息"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:elevation="10dp"
            app:cornerRadius="28dp"
            />
    </LinearLayout>

    <!-- App List Panel REMOVED -->

</FrameLayout>