<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/zzPageBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="82dp">

        <!-- 标题区域 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="使用统计"
            android:textColor="?attr/zzText"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="时间范围和日期构成分开筛选，数据会实时重算。"
            android:textColor="?attr/zzMuted"
            android:textSize="13sp" />

        <!-- 顶层两栏筛选控制器 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_open_range"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_zz_control_btn"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="时间范围"
                        android:textColor="?attr/zzMuted"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tv_range_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="本周"
                        android:textColor="?attr/zzText"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌄"
                    android:textColor="?attr/zzMuted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_open_filter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_zz_control_btn"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="日期构成 / 应用"
                        android:textColor="?attr/zzMuted"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tv_filter_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="全部星期 · 全部应用"
                        android:textColor="?attr/zzText"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌄"
                    android:textColor="?attr/zzMuted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 一级业务页签：休息 / 起床 / 应用 / 规则保护 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/tab_rest"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_zz_option_btn_selected"
                    app:backgroundTint="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="休息"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/tab_alarm"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_zz_option_btn"
                    app:backgroundTint="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="起床"
                    android:textAllCaps="false"
                    android:textColor="?attr/zzText"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/tab_apps"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_zz_option_btn"
                    app:backgroundTint="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="应用"
                    android:textAllCaps="false"
                    android:textColor="?attr/zzText"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/tab_rules"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_zz_option_btn"
                    app:backgroundTint="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="规则保护"
                    android:textAllCaps="false"
                    android:textColor="?attr/zzText"
                    android:textSize="13sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 主统计与图表卡片 -->
        <LinearLayout
            android:id="@+id/card_main_chart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_zz_card"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- 卡片头部标题与颗粒度徽章 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_card_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="休息"
                        android:textColor="?attr/zzText"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_card_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="本周 · 全部星期"
                        android:textColor="?attr/zzMuted"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_card_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_zz_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="正常出口"
                    android:textColor="?attr/zzAccentStrong"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 规则保护专属 Hero 区域 -->
            <LinearLayout
                android:id="@+id/layout_rule_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_zz_kpi_card"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="申请过放宽的规则项"
                    android:textColor="?attr/zzMuted"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_rule_hero_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0 项"
                    android:textColor="?attr/zzAccentStrong"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="同一规则连续修改不重复计成多项，重点看原来的边界最终是恢复、部分恢复，还是正式放宽生效。"
                    android:textColor="?attr/zzMuted"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 权限提示条 (未授予使用情况访问权限时展示) -->
            <LinearLayout
                android:id="@+id/layout_usage_permission_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_zz_kpi_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️"
                    android:textSize="18sp"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未授予「使用情况访问权限」"
                        android:textColor="?attr/zzText"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="无法统计手机真实应用与游戏使用时长"
                        android:textColor="?attr/zzMuted"
                        android:textSize="10sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_grant_usage_permission"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_zz_option_btn_selected"
                    app:backgroundTint="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="去授权"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2x2 KPI 栅格容器 -->
            <GridLayout
                android:id="@+id/grid_kpis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="2"
                android:useDefaultMargins="false">

                <!-- KPI 1 -->
                <LinearLayout
                    android:id="@+id/kpi_card_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_zz_kpi_card"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_kpi_title_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="休息"
                        android:textColor="?attr/zzMuted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_kpi_val_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0 次"
                        android:textColor="?attr/zzText"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_kpi_sub_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0m"
                        android:textColor="?attr/zzAccentStrong"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- KPI 2 -->
                <LinearLayout
                    android:id="@+id/kpi_card_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_zz_kpi_card"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_kpi_title_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="临时解锁"
                        android:textColor="?attr/zzMuted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_kpi_val_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0 次"
                        android:textColor="?attr/zzText"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_kpi_sub_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0m"
                        android:textColor="?attr/zzAccentStrong"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- KPI 3 -->
                <LinearLayout
                    android:id="@+id/kpi_card_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_zz_kpi_card"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_kpi_title_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="特权"
                        android:textColor="?attr/zzMuted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_kpi_val_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0 次"
                        android:textColor="?attr/zzText"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_kpi_sub_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0m"
                        android:textColor="?attr/zzAccentStrong"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- KPI 4 -->
                <LinearLayout
                    android:id="@+id/kpi_card_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_zz_kpi_card"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_kpi_title_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="冷却中再次申请"
                        android:textColor="?attr/zzMuted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_kpi_val_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0 次"
                        android:textColor="?attr/zzText"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_kpi_sub_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="只记申请事件"
                        android:textColor="?attr/zzAccentStrong"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </GridLayout>

            <!-- 子维度切换按钮 [时长/时间] vs [次数/耗时] -->
            <LinearLayout
                android:id="@+id/layout_metric_toggle"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_zz_subtab_bg"
                android:orientation="horizontal"
                android:padding="2dp">

                <Button
                    android:id="@+id/btn_metric_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_zz_option_btn_selected"
                    app:backgroundTint="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="时长"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_metric_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_zz_option_btn"
                    app:backgroundTint="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="次数"
                    android:textAllCaps="false"
                    android:textColor="?attr/zzText"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 图表说明行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_chart_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="休息 / 临时解锁 / 特权 · 时长"
                    android:textColor="?attr/zzText"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_chart_type_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="堆叠柱状图"
                    android:textColor="?attr/zzMuted"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 图例行 -->
            <LinearLayout
                android:id="@+id/layout_legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/legend_item_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dot_legend_1"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="?attr/zzAccent" />

                    <TextView
                        android:id="@+id/tv_legend_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="休息"
                        android:textColor="?attr/zzText"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/legend_item_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dot_legend_2"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="?attr/zzAlt" />

                    <TextView
                        android:id="@+id/tv_legend_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="临时解锁"
                        android:textColor="?attr/zzText"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/legend_item_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dot_legend_3"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="?attr/zzWarning" />

                    <TextView
                        android:id="@+id/tv_legend_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="特权"
                        android:textColor="?attr/zzText"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- MPAndroidChart 自适应双图表容器 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="6dp">

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/chart_bar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart_line"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 图表说明文字 -->
            <TextView
                android:id="@+id/tv_chart_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:textColor="?attr/zzMuted"
                android:textSize="10sp" />

            <!-- 应用页专属排行榜与列表 -->
            <LinearLayout
                android:id="@+id/layout_apps_extra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 视图模式切换：大类汇总（游戏合并） vs 单应用排行 -->
                <LinearLayout
                    android:id="@+id/layout_app_view_mode_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_app_view_categorized"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_zz_option_btn_selected"
                        app:backgroundTint="@null"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text="大类汇总（游戏合并）"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_app_view_individual"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_zz_option_btn"
                        app:backgroundTint="@null"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text="单应用真实排行"
                        android:textColor="?attr/zzText"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_app_rank_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="打开次数排行"
                        android:textColor="?attr/zzText"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="点击应用看单独趋势"
                        android:textColor="?attr/zzMuted"
                        android:textSize="9sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_app_list_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="16dp"
                    android:gravity="center"
                    android:text="当前时间段内暂无应用使用记录"
                    android:textColor="?attr/zzMuted"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layout_rank_bars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/layout_app_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 起床页专属最近记录 -->
            <LinearLayout
                android:id="@+id/layout_alarm_extra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="最近记录"
                        android:textColor="?attr/zzText"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="最多 5 天"
                        android:textColor="?attr/zzMuted"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_alarm_recent_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 规则保护专属最近记录 -->
            <LinearLayout
                android:id="@+id/layout_rules_extra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="最近规则变化"
                        android:textColor="?attr/zzText"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="查看具体规则项"
                        android:textColor="?attr/zzMuted"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_rules_recent_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>

        <!-- 次级信息说明卡片 -->
        <LinearLayout
            android:id="@+id/card_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_zz_card"
            android:orientation="vertical"
            android:padding="13dp">

            <TextView
                android:id="@+id/tv_secondary_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="冷却中再次申请"
                android:textColor="?attr/zzText"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_secondary_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="冷却中的再次申请不是一次成功出口，因此不叠进休息图，只单独记录次数。"
                android:textColor="?attr/zzMuted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- 契约兼容保留：勿扰时长、加权、换算表 ID，供单测契约与旧 API 兼容保证 -->
        <!-- ============================================================ -->
        <TextView
            android:id="@+id/tv_legacy_compat_dnd"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:text="勿扰时长已整合至全天使用与规则保护统计"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/cb_weighted_stats"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_show_conversion"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
