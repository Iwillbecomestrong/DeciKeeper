<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:background="@drawable/bg_sea_surface">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 使用统计"
            android:textColor="#004D40"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 第二行：类型切换（周/月/年）单独一行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/btn_week_stats"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="周统计"
            android:textSize="12sp"
            android:backgroundTint="#00838F"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_month_stats"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="月统计"
            android:textSize="12sp"
            android:backgroundTint="#757575"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_year_stats"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="年统计"
            android:textSize="12sp"
            android:backgroundTint="#757575" />
    </LinearLayout>

    <!-- 第三行：统计数据选择（休息时长/自律时长）单独一行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <RadioGroup
            android:id="@+id/rg_stats_type"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:checkedButton="@+id/rb_stats_rest">

            <RadioButton
                android:id="@+id/rb_stats_rest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="休息时长"
                android:textColor="#616161"
                android:textSize="13sp"
                android:buttonTint="#00838F"
                android:layout_marginEnd="16dp"/>

            <RadioButton
                android:id="@+id/rb_stats_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自律时长"
                android:textColor="#616161"
                android:textSize="13sp"
                android:buttonTint="#00838F"/>
        </RadioGroup>

        <CheckBox
            android:id="@+id/cb_weighted_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="加权"
            android:textColor="#616161"
            android:textSize="13sp"
            android:buttonTint="#00838F" />

        <TextView
            android:id="@+id/btn_show_conversion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="换算表"
            android:textColor="#00838F"
            android:textStyle="bold"
            android:textSize="13sp"
            android:paddingStart="6dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>
    </LinearLayout>

    <!-- 主内容区（图表，高度降低） -->
    <!-- 周统计视图 -->
    <LinearLayout
        android:id="@+id/layout_week_stats"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.7"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="visible">

        <!-- 周选择器 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btn_prev_week"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="◀"
                android:textSize="14sp"
                android:backgroundTint="#00838F"
                android:padding="0dp"
                android:minWidth="0dp" />

            <TextView
                android:id="@+id/tv_week_range"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="本周"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#00838F" />

            <Button
                android:id="@+id/btn_next_week"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="▶"
                android:textSize="14sp"
                android:backgroundTint="#00838F"
                android:padding="0dp"
                android:minWidth="0dp" />
        </LinearLayout>

        <!-- 柱状图 -->
        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/chart_week"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 月统计视图 -->
    <LinearLayout
        android:id="@+id/layout_month_stats"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.7"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <!-- 月选择器 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btn_prev_month"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="◀"
                android:textSize="14sp"
                android:backgroundTint="#00838F"
                android:padding="0dp"
                android:minWidth="0dp" />

            <TextView
                android:id="@+id/tv_month_range"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="本月"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#00838F" />

            <Button
                android:id="@+id/btn_next_month"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="▶"
                android:textSize="14sp"
                android:backgroundTint="#00838F"
                android:padding="0dp"
                android:minWidth="0dp" />
        </LinearLayout>

        <!-- 折线图 -->
        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chart_month"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 年统计视图 -->
    <LinearLayout
        android:id="@+id/layout_year_stats"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.7"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <!-- 年选择器 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btn_prev_year"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="◀"
                android:textSize="14sp"
                android:backgroundTint="#00838F"
                android:padding="0dp"
                android:minWidth="0dp" />

            <TextView
                android:id="@+id/tv_year_range"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="本年"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#00838F" />

            <Button
                android:id="@+id/btn_next_year"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="▶"
                android:textSize="14sp"
                android:backgroundTint="#00838F"
                android:padding="0dp"
                android:minWidth="0dp" />
        </LinearLayout>

        <!-- 条形图 -->
        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/chart_year"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

</LinearLayout>
