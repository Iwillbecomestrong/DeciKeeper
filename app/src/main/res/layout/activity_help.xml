<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/zzPageBg"
    android:clipToPadding="false"
    android:paddingStart="20dp"
    android:paddingTop="28dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="使用说明" android:textColor="?attr/zzText" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="16dp" android:text="快速理解“勿扰时段 + 应用时间窗 + 出口”。" android:textColor="?attr/zzMuted" android:textSize="13sp" />

        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardBackgroundColor="?attr/zzSurface" app:cardCornerRadius="18dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1. 勿扰时段" android:textColor="?attr/zzText" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="4dp" android:text="决定什么时候进入需要约束的状态。学习、工作和睡眠都可以设置独立时段；每个时段保留自己的休息时长、次数和黑白名单。" android:textColor="?attr/zzMuted" android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardBackgroundColor="?attr/zzSurface" app:cardCornerRadius="18dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2. 应用时间窗" android:textColor="?attr/zzText" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="4dp" android:text="决定娱乐应用什么时候才有资格打开。时间窗不是额外加严，而是为娱乐预留确定窗口；如果同时处于勿扰时段，仍需满足休息或空档条件。" android:textColor="?attr/zzMuted" android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardBackgroundColor="?attr/zzSurface" app:cardCornerRadius="18dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3. 三种出口" android:textColor="?attr/zzText" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="4dp" android:text="申请休息：正常消耗本时段额度，只解除勿扰锁。\n\n临时解锁：短时间打开当前受限应用，可解除应用时间窗锁；额度不足时按规则借用下一阶段。\n\n每周特权：少量但更长的自由出口，在全局参数设定的可用时间范围内使用。" android:textColor="?attr/zzMuted" android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardBackgroundColor="?attr/zzAccentSofter" app:cardCornerRadius="18dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="生效原则" android:textColor="?attr/zzAccentStrong" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:lineSpacingExtra="4dp" android:text="决定守护允许你休息，也允许你反悔，但不会让一次冲动立刻接管此前做出的决定。默认“宽严有别”：更严格的调整可以立即生效，放宽约束的调整按对应规则延迟生效。" android:textColor="?attr/zzMuted" android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" app:cardBackgroundColor="?attr/zzSurface" app:cardCornerRadius="18dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="权限在哪里设置？" android:textColor="?attr/zzText" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:lineSpacingExtra="4dp" android:text="首次使用所需的基础权限在主页初始化流程逐项开启；无障碍服务属于“加强约束功能”，在设置页按需开启；闹钟需要的保活与附加权限在闹钟页自己的入口中处理。" android:textColor="?attr/zzMuted" android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button android:id="@+id/btn_close_help" android:layout_width="match_parent" android:layout_height="52dp" android:backgroundTint="?attr/zzAccent" android:text="我已了解" android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
