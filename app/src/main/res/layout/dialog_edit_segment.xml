<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- 时段名称 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="时段名称"
        android:textSize="14sp"
        android:textColor="?attr/zzText"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/et_edit_name"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="14dp"
        android:textSize="14sp"
        android:textColor="?attr/zzText"
        android:textColorHint="?attr/zzSubtle"
        android:layout_marginBottom="16dp"/>

    <!-- 时间范围 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="时间范围"
        android:textSize="14sp"
        android:textColor="?attr/zzText"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_edit_start"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:backgroundTint="?attr/zzSurface2"
            android:textColor="?attr/zzText"
            android:text="08:00"
            android:gravity="center"
            android:textAllCaps="false"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  -  "
            android:textSize="18sp"
            android:textColor="?attr/zzMuted"/>

        <Button
            android:id="@+id/btn_edit_end"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:backgroundTint="?attr/zzSurface2"
            android:textColor="?attr/zzText"
            android:text="12:00"
            android:gravity="center"
            android:textAllCaps="false"
            android:textSize="16sp"/>
    </LinearLayout>

    <!-- 休息时长 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="休息时长 (分钟)"
                android:textSize="14sp"
                android:textColor="?attr/zzText"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_edit_limit"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="14dp"
                android:inputType="number"
                android:textSize="14sp"
                android:textColor="?attr/zzText"
                android:textColorHint="?attr/zzSubtle"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 可用次数 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="可用次数"
            android:textSize="14sp"
            android:textColor="?attr/zzText"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/et_edit_usable_count"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="14dp"
            android:inputType="number"
            android:textSize="14sp"
            android:textColor="?attr/zzText"
            android:textColorHint="?attr/zzSubtle"
            android:hint="留空=自动计算"/>

        <TextView
            android:id="@+id/tv_usable_count_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="默认 = 时长 ÷ 30min = X 次"
            android:textColor="?attr/zzMuted"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- 生效周期 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="生效周期"
        android:textSize="14sp"
        android:textColor="?attr/zzText"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btn_edit_days"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="?attr/zzSurface2"
        android:textColor="?attr/zzText"
        android:text="每天"
        android:gravity="center"
        android:textAllCaps="false"/>

    <!-- 本时段黑/白名单 -->
    <LinearLayout
        android:id="@+id/ll_segment_list_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btn_edit_segment_list"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="?attr/zzAccent"
            android:textColor="@android:color/white"
            android:text="本时段黑/白名单"
            android:gravity="center"
            android:textAllCaps="false"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/tv_segment_list_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="跟随全局黑/白名单"
            android:textColor="?attr/zzMuted"
            android:textSize="12sp"/>
    </LinearLayout>

</LinearLayout>
