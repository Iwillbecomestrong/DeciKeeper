<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/zzPageBg"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/zzSurface"
        app:title="应用时间窗预览"
        app:titleTextColor="?attr/zzText" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/zzSurface" android:orientation="vertical" android:paddingBottom="10dp">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabGravity="center"
            app:tabIndicatorColor="?attr/zzAccent"
            app:tabMode="fixed"
            app:tabSelectedTextColor="?attr/zzAccentStrong"
            app:tabTextColor="?attr/zzMuted" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/zzLine" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupView"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            app:checkedButton="@id/btnViewByApp"
            app:selectionRequired="true"
            app:singleSelection="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnViewByApp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="match_parent" android:paddingVertical="0dp" android:text="按应用查看" android:textColor="?attr/zzText" android:textSize="12sp" app:backgroundTint="?attr/zzSurface2" app:strokeColor="?attr/zzLine" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnViewByTime" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="match_parent" android:paddingVertical="0dp" android:text="按时段查看" android:textColor="?attr/zzText" android:textSize="12sp" app:backgroundTint="?attr/zzSurface2" app:strokeColor="?attr/zzLine" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="32dp" android:text="该日无生效规则" android:textColor="?attr/zzSubtle" android:textSize="14sp" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerView" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingHorizontal="12dp" android:paddingTop="8dp" android:paddingBottom="16dp" />
</LinearLayout>
