<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/zzSurface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/tvName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" android:text="时间窗名称" android:textColor="?attr/zzText" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:fontFamily="monospace" android:text="19:30–21:00" android:textColor="?attr/zzAccentStrong" android:textSize="13sp" android:textStyle="bold" />
            <ImageButton android:id="@+id/btnDelete" android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/bg_zz_pill" android:backgroundTint="?attr/zzDangerSoft" android:padding="5dp" android:scaleType="centerInside" android:src="@android:drawable/ic_menu_delete" app:tint="?attr/zzDanger" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/tvDays" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_zz_pill" android:backgroundTint="?attr/zzAltSoft" android:paddingHorizontal="9dp" android:paddingVertical="4dp" android:text="每天" android:textColor="?attr/zzAlt" android:textSize="11sp" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <Switch android:id="@+id/switchEnable" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:id="@+id/layoutAppPreview" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                <LinearLayout android:id="@+id/llAppIcons" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" />
            </LinearLayout>
            <TextView android:id="@+id/tvStatusBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_zz_pill" android:backgroundTint="?attr/zzWarning" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:text="待生效" android:textColor="@android:color/white" android:textSize="10sp" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
