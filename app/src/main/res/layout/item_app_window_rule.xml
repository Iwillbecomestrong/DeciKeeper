<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#CCFFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Row 1: Name + Time + Delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rule Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#006064"
                android:layout_marginEnd="8dp"/>

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19:30 - 21:00"
                android:textColor="#004D40"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"/>

            <!-- Delete Button (Top Right) -->
             <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_sea_bubble"
                android:backgroundTint="#FFE0E0"
                android:src="@android:drawable/ic_menu_delete"
                android:scaleType="centerInside"
                android:padding="4dp"
                app:tint="#D32F2F" />
        </LinearLayout>

        <!-- Row 2: Days Badge + Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- Days Badge -->
            <TextView
                android:id="@+id/tvDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="每天"
                android:textSize="12sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_sea_bubble"
                android:textColor="#F57C00"/>

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- Enable Switch -->
            <Switch
                android:id="@+id/switchEnable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="#5E35B1"
                android:trackTint="#D1C4E9"/>

        </LinearLayout>

        <!-- Row 3: App Icons + Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- App Icons Preview -->
            <LinearLayout
                android:id="@+id/layoutAppPreview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:id="@+id/llAppIcons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />

            </LinearLayout>

            <!-- Status Badge (Pending Changes) -->
            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="待生效: 删除"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:background="#FFA726" 
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:visibility="gone"/>
                
        </LinearLayout>
            
    </LinearLayout>

</androidx.cardview.widget.CardView>
