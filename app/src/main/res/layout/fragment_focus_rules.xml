<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/zzPageBg"
    android:paddingTop="18dp"
    android:clipToPadding="false">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_focus_rules"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_focus_rules_tab_container"
        android:backgroundTint="?attr/zzSurface"
        android:padding="4dp"
        app:tabBackground="@drawable/selector_focus_rules_tab"
        app:tabGravity="fill"
        app:tabIndicatorHeight="0dp"
        app:tabMode="fixed"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextColor="@android:color/white"
        app:tabTextColor="?attr/zzMuted" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager_focus_rules"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
