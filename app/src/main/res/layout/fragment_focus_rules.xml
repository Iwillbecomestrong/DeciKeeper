<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/zzPageBg"
    android:paddingTop="18dp"
    android:clipToPadding="false">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_focus_rules"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_focus_rules_tab_container"
        android:backgroundTint="?attr/zzSurface"
        android:padding="4dp"
        app:tabBackground="@drawable/selector_focus_rules_tab"
        app:tabGravity="fill"
        app:tabIndicatorHeight="0dp"
        app:tabMode="fixed"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextColor="@android:color/white"
        app:tabTextColor="?attr/zzMuted" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager_focus_rules"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_time_rule_policy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardBackgroundColor="?attr/zzSurface"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="时间规则生效策略"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?attr/zzText" />

                <TextView
                    android:id="@+id/tv_time_rule_policy_current"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="当前：宽严有别"
                    android:textSize="12sp"
                    android:textColor="?attr/zzAccentStrong" />

                <TextView
                    android:id="@+id/tv_time_rule_policy_scope"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="仅影响勿扰时段和应用时间窗"
                    android:textSize="11sp"
                    android:textColor="?attr/zzMuted" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="›"
                android:textSize="26sp"
                android:textColor="?attr/zzAccentStrong" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
