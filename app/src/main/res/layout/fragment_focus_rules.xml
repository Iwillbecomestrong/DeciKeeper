<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/zzPageBg"
    android:paddingTop="18dp"
    android:clipToPadding="false">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_focus_rules"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_focus_rules_tab_container"
        android:backgroundTint="?attr/zzSurface"
        android:padding="4dp"
        app:tabBackground="@drawable/selector_focus_rules_tab"
        app:tabGravity="fill"
        app:tabIndicatorHeight="0dp"
        app:tabMode="fixed"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextColor="@android:color/white"
        app:tabTextColor="?attr/zzMuted" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager_focus_rules"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="?attr/zzSurface"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="时间规则生效策略"
                    android:textColor="?attr/zzText"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_effective_policy_help"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_zz_pill"
                    android:backgroundTint="?attr/zzAccentSoft"
                    android:gravity="center"
                    android:text="?"
                    android:textColor="?attr/zzAccentStrong"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="仅控制勿扰时段和应用时间窗的修改何时生效"
                android:textColor="?attr/zzMuted"
                android:textSize="11sp" />

            <android.widget.RadioGroup
                android:id="@+id/rg_effective_policy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_policy_favorable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="?attr/zzAccent"
                    android:paddingVertical="6dp"
                    android:text="「宽严有别」（推荐）\n加严立即，放宽下一刷新时刻"
                    android:textColor="?attr/zzText"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb_policy_all_next_day"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="?attr/zzAccent"
                    android:paddingVertical="6dp"
                    android:text="「全部次日」\n两类时间规则的修改都在下一刷新时刻生效"
                    android:textColor="?attr/zzText"
                    android:textSize="13sp" />
            </android.widget.RadioGroup>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
