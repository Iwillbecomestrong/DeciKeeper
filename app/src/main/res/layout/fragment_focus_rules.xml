<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_sea_surface"
    android:paddingTop="40dp"
    android:clipToPadding="false">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_focus_rules"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_focus_rules_tab_container"
        android:padding="4dp"
        app:tabBackground="@drawable/selector_focus_rules_tab"
        app:tabGravity="fill"
        app:tabIndicatorHeight="0dp"
        app:tabMode="fixed"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextColor="#FFFFFF"
        app:tabTextColor="#006064" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager_focus_rules"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_time_rule_policy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardBackgroundColor="#E3F2FD"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="时间规则生效策略"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0D47A1" />

                <TextView
                    android:id="@+id/tv_time_rule_policy_current"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="当前：宽严有别"
                    android:textSize="13sp"
                    android:textColor="#1565C0" />

                <TextView
                    android:id="@+id/tv_time_rule_policy_scope"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="仅影响勿扰时段和应用时间窗"
                    android:textSize="11sp"
                    android:textColor="#607D8B" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="›"
                android:textSize="28sp"
                android:textColor="#1565C0" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>