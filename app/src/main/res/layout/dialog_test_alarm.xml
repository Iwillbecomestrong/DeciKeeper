<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="解锁流程"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/zzText"
                android:layout_marginBottom="4dp" />

            <RadioGroup
                android:id="@+id/rg_unlock_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/rb_unlock_single"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="单次"
                    android:textSize="13sp"
                    android:textColor="?attr/zzText" />

                <RadioButton
                    android:id="@+id/rb_unlock_two_stage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="双阶段"
                    android:textSize="13sp"
                    android:textColor="?attr/zzText" />
            </RadioGroup>

            <!-- 第一关 -->
            <LinearLayout
                android:id="@+id/layout_stage1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tv_stage1_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="解锁方式配置（可并联多选）"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/zzText"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <CheckBox android:id="@+id/cb_s1_qr" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="扫码" android:checked="true" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                    <CheckBox android:id="@+id/cb_s1_math" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="数学" android:checked="true" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                    <CheckBox android:id="@+id/cb_s1_poem" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="诗词" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                    <CheckBox android:id="@+id/cb_s1_word" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="单词" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                </LinearLayout>

                <!-- 第二行：选词填空 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <CheckBox android:id="@+id/cb_s1_cloze" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="选词填空" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                    <Space android:layout_width="0dp" android:layout_weight="3" android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_s1_custom_banks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </LinearLayout>

            <!-- 第一关防回床倒计时缓冲（双阶段模式下可见） -->
            <LinearLayout
                android:id="@+id/layout_stage1_cooldown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/zzSurface2"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tv_cooldown_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="完成后延迟"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/zzText" />

                <TextView
                    android:id="@+id/tv_cooldown_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="第一关完成后进入最低强度提醒并等待，倒计时结束后进入第二关或允许关闭（0=立即生效）"
                    android:textSize="11sp"
                    android:textColor="?attr/zzMuted"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/et_stage_cooldown"
                        android:layout_width="60dp"
                        android:layout_height="36dp"
                        android:inputType="number"
                        android:text="0"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:textColor="?attr/zzText"
                        android:background="@drawable/bg_input_field" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" 秒"
                        android:textSize="12sp"
                        android:textColor="?attr/zzMuted"
                        android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 第二关 -->
            <LinearLayout
                android:id="@+id/layout_stage2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="第二关解锁方式（通过其一即可）"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/zzText"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <CheckBox android:id="@+id/cb_s2_qr" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="扫码" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                    <CheckBox android:id="@+id/cb_s2_math" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="数学" android:checked="true" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                    <CheckBox android:id="@+id/cb_s2_poem" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="诗词" android:checked="true" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                    <CheckBox android:id="@+id/cb_s2_word" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="单词" android:checked="true" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                </LinearLayout>

                <!-- 第二行：选词填空 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">
                    <CheckBox android:id="@+id/cb_s2_cloze" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="选词填空" android:textSize="12sp" android:textColor="?attr/zzText" android:gravity="center_vertical" android:includeFontPadding="false" />
                    <Space android:layout_width="0dp" android:layout_weight="3" android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_s2_custom_banks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </LinearLayout>

            <!-- 默认挑战数量（独立区域，与默认设置弹窗一致，仅题目数量不同） -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="默认挑战数量"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/zzText"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="3dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="数学 " android:textSize="13sp" android:textColor="?attr/zzText" />
                    <EditText android:id="@+id/et_math_count" android:layout_width="52dp" android:layout_height="38dp" android:inputType="number" android:text="1" android:gravity="center" android:textSize="13sp" android:textColor="?attr/zzText" android:background="@drawable/bg_input_field" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 道" android:textSize="12sp" android:textColor="?attr/zzMuted" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="诗词 " android:textSize="13sp" android:textColor="?attr/zzText" />
                    <EditText android:id="@+id/et_poem_count" android:layout_width="52dp" android:layout_height="38dp" android:inputType="number" android:text="1" android:gravity="center" android:textSize="13sp" android:textColor="?attr/zzText" android:background="@drawable/bg_input_field" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 句" android:textSize="12sp" android:textColor="?attr/zzMuted" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="3dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="单词 " android:textSize="13sp" android:textColor="?attr/zzText" />
                    <EditText android:id="@+id/et_word_count" android:layout_width="52dp" android:layout_height="38dp" android:inputType="number" android:text="1" android:gravity="center" android:textSize="13sp" android:textColor="?attr/zzText" android:background="@drawable/bg_input_field" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 个" android:textSize="12sp" android:textColor="?attr/zzMuted" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="选词填空 " android:textSize="13sp" android:textColor="?attr/zzText" />
                    <EditText android:id="@+id/et_cloze_count" android:layout_width="52dp" android:layout_height="38dp" android:inputType="number" android:text="3" android:gravity="center" android:textSize="13sp" android:textColor="?attr/zzText" android:background="@drawable/bg_input_field" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 道" android:textSize="12sp" android:textColor="?attr/zzMuted" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="题库 " android:textSize="13sp" android:textColor="?attr/zzText" />
                    <EditText android:id="@+id/et_custom_count" android:layout_width="52dp" android:layout_height="38dp" android:inputType="number" android:text="3" android:gravity="center" android:textSize="13sp" android:textColor="?attr/zzText" android:background="@drawable/bg_input_field" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 道" android:textSize="12sp" android:textColor="?attr/zzMuted" />
                </LinearLayout>
                <Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- 稍后提醒设置（小睡） -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="稍后提醒（小睡）"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/zzText"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="间隔 " android:textSize="13sp" android:textColor="?attr/zzText" />
                    <EditText android:id="@+id/et_snooze_minutes" android:layout_width="52dp" android:layout_height="38dp" android:inputType="number" android:text="10" android:gravity="center" android:textSize="13sp" android:textColor="?attr/zzText" android:background="@drawable/bg_input_field" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 分钟" android:textSize="12sp" android:textColor="?attr/zzMuted" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="最多 " android:textSize="13sp" android:textColor="?attr/zzText" />
                    <EditText android:id="@+id/et_snooze_max_count" android:layout_width="52dp" android:layout_height="38dp" android:inputType="number" android:text="2" android:gravity="center" android:textSize="13sp" android:textColor="?attr/zzText" android:background="@drawable/bg_input_field" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 次" android:textSize="12sp" android:textColor="?attr/zzMuted" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
