<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/zzSurface"
    android:orientation="vertical"
    android:padding="18dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_range_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择时间范围"
            android:textColor="?attr/zzText"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_range_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_range_title"
            android:layout_marginTop="3dp"
            android:text="第一层筛选：决定“从哪一天看到哪一天”。"
            android:textColor="?attr/zzMuted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btn_close_range_sheet"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="?attr/zzMuted"
            android:textSize="18sp" />
    </RelativeLayout>

    <GridLayout
        android:id="@+id/grid_range_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:columnCount="2"
        android:useDefaultMargins="true">

        <Button
            android:id="@+id/opt_range_today"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_zz_option_btn"
            android:text="今天"
            android:textAllCaps="false"
            android:textColor="?attr/zzText"
            android:textSize="12sp" />

        <Button
            android:id="@+id/opt_range_yesterday"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_zz_option_btn"
            android:text="昨天"
            android:textAllCaps="false"
            android:textColor="?attr/zzText"
            android:textSize="12sp" />

        <Button
            android:id="@+id/opt_range_this_week"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_zz_option_btn_selected"
            android:text="本周"
            android:textAllCaps="false"
            android:textColor="?attr/zzAccentStrong"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/opt_range_last_week"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_zz_option_btn"
            android:text="上周"
            android:textAllCaps="false"
            android:textColor="?attr/zzText"
            android:textSize="12sp" />

        <Button
            android:id="@+id/opt_range_last_7"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_zz_option_btn"
            android:text="近 7 天"
            android:textAllCaps="false"
            android:textColor="?attr/zzText"
            android:textSize="12sp" />

        <Button
            android:id="@+id/opt_range_this_month"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_zz_option_btn"
            android:text="本月"
            android:textAllCaps="false"
            android:textColor="?attr/zzText"
            android:textSize="12sp" />

        <Button
            android:id="@+id/opt_range_last_month"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_zz_option_btn"
            android:text="上月"
            android:textAllCaps="false"
            android:textColor="?attr/zzText"
            android:textSize="12sp" />

        <Button
            android:id="@+id/opt_range_last_30"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_zz_option_btn"
            android:text="近 30 天"
            android:textAllCaps="false"
            android:textColor="?attr/zzText"
            android:textSize="12sp" />

        <Button
            android:id="@+id/opt_range_this_year"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_zz_option_btn"
            android:text="本年"
            android:textAllCaps="false"
            android:textColor="?attr/zzText"
            android:textSize="12sp" />

        <Button
            android:id="@+id/opt_range_custom"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_zz_option_btn"
            android:text="自定义日期"
            android:textAllCaps="false"
            android:textColor="?attr/zzText"
            android:textSize="12sp" />
    </GridLayout>

    <!-- 自定义起止日期容器 -->
    <LinearLayout
        android:id="@+id/layout_custom_date_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开始日期"
                    android:textColor="?attr/zzMuted"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_custom_start_date"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_zz_option_btn"
                    android:text="2026-08-20"
                    android:textAllCaps="false"
                    android:textColor="?attr/zzText"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="结束日期"
                    android:textColor="?attr/zzMuted"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_custom_end_date"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_zz_option_btn"
                    android:text="2026-09-07"
                    android:textAllCaps="false"
                    android:textColor="?attr/zzText"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btn_apply_custom_range"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_zz_primary_btn"
            android:text="应用日期范围"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
