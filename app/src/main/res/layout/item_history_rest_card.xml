<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_history_rest_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_zz_kpi_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 主展示行（折叠态也能看到） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_history_rest_type_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_zz_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="?attr/zzAccent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_history_rest_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="?attr/zzText"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_history_rest_cost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/zzText"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_history_rest_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="▼"
            android:textColor="?attr/zzMuted"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 副信息：左使用前，右变动后结余（长文本允许折行，不截断） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_history_rest_before"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/zzMuted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_history_rest_balance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="?attr/zzMuted"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 展开详情：行由代码按 RestLedger.detailLines 生成（时长 | 次数并排，版式同主页） -->
    <LinearLayout
        android:id="@+id/layout_history_rest_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_zz_card"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone" />
</LinearLayout>
