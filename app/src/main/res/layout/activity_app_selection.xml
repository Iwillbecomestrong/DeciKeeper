<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7F4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tv_title_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="屏蔽应用"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#233128" />

        <TextView
            android:id="@+id/tv_mode_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="黑名单模式：勾选的应用会被拦截，其他应用默认允许"
            android:textSize="13sp"
            android:textColor="#66736A" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_list_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="白名单模式"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#344139" />

        <androidx.cardview.widget.CardView
            android:id="@+id/card_pending_changes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFF7E8"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tv_lockout_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#A45D37"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="延迟生效修改"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#8D6B37" />

                <TextView
                    android:id="@+id/tv_pending_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="#5B5042" />

                <TextView
                    android:id="@+id/tv_pending_hint_legacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="包含次日生效的名单移除操作"
                    android:textSize="11sp"
                    android:textColor="#817568" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_segment_tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:background="#F5F7F4"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_select_all"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="全选"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="#405047"
            android:backgroundTint="#E4EAE5"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_invert"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="反选"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="#405047"
            android:backgroundTint="#E4EAE5"
            android:layout_marginHorizontal="4dp" />

        <Button
            android:id="@+id/btn_restore_global"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1.35"
            android:text="恢复全局"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="#405047"
            android:backgroundTint="#E4EAE5"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="#E4E9E5"
        android:paddingTop="1dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.12"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:layout_marginEnd="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="全部应用"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#344139"
                android:paddingHorizontal="12dp"
                android:paddingVertical="11dp"
                android:background="#F1F4F1" />

            <Button
                android:id="@+id/btn_quick_import"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="7dp"
                android:text="批量勾选与新应用自动拦截"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:textColor="#506057"
                android:backgroundTint="#EEF2EE" />

            <EditText
                android:id="@+id/et_search_apps"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:hint="搜索应用"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="7dp"
                android:paddingHorizontal="10dp"
                android:textSize="13sp"
                android:textColor="#2E3A32"
                android:textColorHint="#8A958D"
                android:backgroundTint="#C9D2CB"
                android:maxLines="1"
                android:inputType="text" />

            <ListView
                android:id="@+id/list_all_apps"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingHorizontal="7dp"
                android:paddingBottom="8dp"
                android:clipToPadding="false"
                android:divider="@null"
                android:dividerHeight="5dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.88"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:layout_marginStart="1dp">

            <TextView
                android:id="@+id/tv_selected_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="已选择"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#52655A"
                android:paddingHorizontal="12dp"
                android:paddingVertical="11dp"
                android:background="#EBF1EC" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="这里始终显示当前选择结果"
                android:textSize="11sp"
                android:textColor="#7A877F"
                android:paddingHorizontal="10dp"
                android:paddingTop="7dp"
                android:paddingBottom="3dp" />

            <ListView
                android:id="@+id/list_selected_apps"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingHorizontal="7dp"
                android:paddingBottom="8dp"
                android:clipToPadding="false"
                android:divider="@null"
                android:dividerHeight="5dp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btn_save_apps"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="保存配置"
        android:textAllCaps="false"
        android:textSize="17sp"
        android:textStyle="bold"
        android:backgroundTint="#78917D"
        android:textColor="#FFFFFF"
        android:layout_margin="14dp" />
</LinearLayout>
