<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_app_selection"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/zzPageBg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/zzSurface"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">
        <TextView android:id="@+id/tv_title_main" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="黑白名单" android:textColor="?attr/zzText" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_mode_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="黑名单模式：勾选的应用会被拦截，其他应用默认允许" android:textColor="?attr/zzMuted" android:textSize="12sp" android:visibility="gone" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_list_mode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="白名单模式" android:textColor="?attr/zzText" android:textSize="13sp" android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:id="@+id/card_pending_changes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/zzWarningSoft"
            app:cardCornerRadius="13dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <TextView android:id="@+id/tv_lockout_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:textColor="?attr/zzWarning" android:textSize="11sp" android:visibility="gone" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="延迟生效修改" android:textColor="?attr/zzWarning" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_pending_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="?attr/zzMuted" android:textSize="11sp" />
                <TextView android:id="@+id/tv_pending_hint_legacy" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="包含次日生效的名单移除操作" android:textColor="?attr/zzSubtle" android:textSize="10sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_segment_tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/zzPageBg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:visibility="gone">
        <Button android:id="@+id/btn_select_all" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:backgroundTint="?attr/zzSurface2" android:text="全选" android:textAllCaps="false" android:textColor="?attr/zzText" android:textSize="12sp" />
        <Button android:id="@+id/btn_invert" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:backgroundTint="?attr/zzSurface2" android:text="反选" android:textAllCaps="false" android:textColor="?attr/zzText" android:textSize="12sp" />
        <Button android:id="@+id/btn_restore_global" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1.25" android:layout_marginStart="4dp" android:backgroundTint="?attr/zzSurface2" android:text="恢复全局" android:textAllCaps="false" android:textColor="?attr/zzText" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/zzLine"
        android:orientation="horizontal"
        android:paddingTop="1dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.12" android:layout_marginEnd="1dp" android:background="?attr/zzSurface" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/zzSurface2" android:paddingHorizontal="12dp" android:paddingVertical="11dp" android:text="全部应用" android:textColor="?attr/zzText" android:textSize="13sp" android:textStyle="bold" />
            <Button android:id="@+id/btn_quick_import" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginHorizontal="8dp" android:layout_marginTop="7dp" android:backgroundTint="?attr/zzAccentSofter" android:text="批量勾选与新应用自动拦截" android:textAllCaps="false" android:textColor="?attr/zzAccentStrong" android:textSize="10sp" />
            <EditText android:id="@+id/et_search_apps" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginHorizontal="8dp" android:layout_marginTop="6dp" android:layout_marginBottom="5dp" android:background="@drawable/bg_input_field" android:drawableStart="@android:drawable/ic_menu_search" android:drawablePadding="7dp" android:hint="搜索应用" android:inputType="text" android:maxLines="1" android:paddingHorizontal="10dp" android:textColor="?attr/zzText" android:textColorHint="?attr/zzSubtle" android:textSize="12sp" />
            <ListView android:id="@+id/list_all_apps" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:divider="@null" android:dividerHeight="5dp" android:paddingHorizontal="7dp" android:paddingBottom="8dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.88" android:layout_marginStart="1dp" android:background="?attr/zzSurface" android:orientation="vertical">
            <TextView android:id="@+id/tv_selected_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/zzAccentSofter" android:paddingHorizontal="12dp" android:paddingVertical="11dp" android:text="已选择" android:textColor="?attr/zzAccentStrong" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="10dp" android:paddingTop="7dp" android:paddingBottom="3dp" android:text="当前选择结果始终显示在这里" android:textColor="?attr/zzSubtle" android:textSize="10sp" />
            <ListView android:id="@+id/list_selected_apps" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:divider="@null" android:dividerHeight="5dp" android:paddingHorizontal="7dp" android:paddingBottom="8dp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btn_save_apps"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="14dp"
        android:backgroundTint="?attr/zzAccent"
        android:text="保存配置"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
