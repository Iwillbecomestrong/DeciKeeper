<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/gentle_night_bg"
    android:padding="24dp">

    <!-- Lights Out Header -->
    <ImageView
        android:id="@+id/iv_moon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:src="@android:drawable/ic_menu_agenda" 
        app:tint="@color/gentle_forest_green"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="晚安，规则"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/gentle_forest_green"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <!-- Typewriter Text -->
    <com.decikeeper.app.TypewriterTextView
        android:id="@+id/tv_lights_out_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/gentle_text_light"
        android:lineSpacingExtra="6dp"
        android:gravity="center_horizontal"
        android:text="" 
        android:minLines="3"/>
        
    <!-- Button Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="32dp">
        
        <Button
            android:id="@+id/btn_close"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="去休息吧"
            android:textColor="@color/gentle_forest_green"/>
    </LinearLayout>

</LinearLayout>
