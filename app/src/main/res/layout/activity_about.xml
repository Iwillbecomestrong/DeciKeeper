<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/zzPageBg"
    android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="关于决定守护" android:textColor="?attr/zzText" android:textSize="25sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="16dp" android:text="知道什么时候停止。" android:textColor="?attr/zzMuted" android:textSize="13sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="应用信息" android:textColor="?attr/zzMuted" android:textSize="13sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_zz_card" android:backgroundTint="?attr/zzSurface" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="应用名称：决定守护" android:textColor="?attr/zzText" android:textSize="14sp" />
            <TextView android:id="@+id/tv_about_version_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="版本：v0.2.0" android:textColor="?attr/zzText" android:textSize="14sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="开发者：决定守护项目组" android:textColor="?attr/zzText" android:textSize="14sp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginBottom="8dp" android:text="功能说明" android:textColor="?attr/zzMuted" android:textSize="13sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_zz_card" android:backgroundTint="?attr/zzSurface" android:lineSpacingExtra="4dp" android:padding="16dp" android:text="决定守护是一款决定保护软件。\n\n它保护的是你在清醒时为未来做出的决定，避免在执行时被下一刻的冲动推翻。\n\n包含两大核心能力：\n1. 规则保护：提前划定勿扰时段与应用使用边界。加严立即生效，放宽次日生效，用时间缓冲区化解冲动反悔；\n2. 挑战闹钟：通过物理扫码、清醒答题等离床动作门禁与唤醒缓冲，让起床不再是一键滑掉，真正开启新的一天。" android:textColor="?attr/zzText" android:textSize="14sp" />
        <LinearLayout android:id="@+id/container_about_entries" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="18dp" />
        <TextView android:id="@+id/tv_about_app_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="18dp" android:textColor="?attr/zzSubtle" android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
