<?xml version="1.0" encoding="utf-8"?>
<!-- 自定义题库挑战卡片：每个已勾选的题库各自实例化一张 -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="?attr/zzSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_custom_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="自定义题库 (0/3)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/zzAccent"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tv_custom_stem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="题目加载中..."
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="?attr/zzText"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="10dp" />

        <!-- 提示按钮 + 提示文字（默认隐藏，点击展开） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_custom_hint"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="💡 提示"
                android:textSize="12sp"
                android:textColor="?attr/zzText"
                android:backgroundTint="?attr/zzSurface2"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_custom_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="?attr/zzMuted"
                android:background="?attr/zzSurface2"
                android:padding="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 选项 2x2 网格 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btn_custom_a"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:text="A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/zzText"
                android:backgroundTint="?attr/zzSurface2"
                android:textAllCaps="false"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_custom_b"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:text="B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/zzText"
                android:backgroundTint="?attr/zzSurface2"
                android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btn_custom_c"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:text="C"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/zzText"
                android:backgroundTint="?attr/zzSurface2"
                android:textAllCaps="false"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_custom_d"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:text="D"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/zzText"
                android:backgroundTint="?attr/zzSurface2"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- 操作栏：跳过 + 提交答案 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btn_custom_skip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="⏭ 跳过"
                android:textSize="13sp"
                android:textColor="?attr/zzText"
                android:backgroundTint="?attr/zzSurface2"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_custom_submit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:layout_marginStart="6dp"
                android:text="提交答案"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:backgroundTint="?attr/zzAccent"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
