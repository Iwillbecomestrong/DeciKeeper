<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_segment"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#CCFFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Row 1: Name + Time Range + Delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_segment_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="①"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#006064"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/tv_segment_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="时段名称"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#004D40"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tv_segment_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:00-12:00"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#00838F"
                android:fontFamily="monospace"
                android:layout_marginEnd="8dp"/>

            <ImageButton
                android:id="@+id/btn_delete_segment"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_sea_bubble"
                android:backgroundTint="#FFE0E0"
                android:src="@android:drawable/ic_menu_delete"
                android:scaleType="centerInside"
                android:padding="4dp"
                app:tint="#D32F2F" />
        </LinearLayout>

        <!-- Row 2: Days Badge + Rest Limit + Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_segment_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="每天"
                android:textSize="12sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_sea_bubble"
                android:textColor="#F57C00"/>

            <TextView
                android:id="@+id/tv_segment_limit_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="休息 30min"
                android:textSize="12sp"
                android:textColor="#78909C"
                android:layout_marginStart="8dp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <Switch
                android:id="@+id/switch_segment_enable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="#5E35B1"
                android:trackTint="#D1C4E9"/>
        </LinearLayout>

        <!-- Row 3: 本时段黑名单摘要（与应用时间窗卡片第三行结构一致：内容区 weight=1 + 右侧徽标） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_segment_list_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="跟随全局黑/白名单"
                android:textSize="12sp"
                android:textColor="#00838F"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tv_new_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="待生效: 新增"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:background="#66BB6A"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:visibility="gone"/>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
