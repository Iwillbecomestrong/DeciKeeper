<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/zzPageBg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="96dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="起床闹钟" android:textColor="?attr/zzText" android:textSize="26sp" android:textStyle="bold" />
            <Button android:id="@+id/btn_emergency_whitelist" android:layout_width="wrap_content" android:layout_height="40dp" android:backgroundTint="?attr/zzSurface2" android:text="应急应用" android:textAllCaps="false" android:textColor="?attr/zzMuted" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="14dp" android:text="手机放身边，二维码放远处；听得到，也避免躺着直接按掉。" android:textColor="?attr/zzMuted" android:textSize="13sp" />

        <androidx.cardview.widget.CardView android:id="@+id/card_alarm_keepalive" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" app:cardBackgroundColor="?attr/zzAccentSofter" app:cardCornerRadius="18dp" app:cardElevation="0dp">
            <LinearLayout android:id="@+id/layout_alarm_keepalive" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="闹钟保活" android:textColor="?attr/zzText" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_keepalive_summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="防睡眠冻结 / 后台保活" android:textColor="?attr/zzMuted" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="?attr/zzSubtle" android:textSize="22sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 兼容旧绑定：已并入统一默认设置，运行时同样会隐藏。 -->
        <androidx.cardview.widget.CardView android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:cardBackgroundColor="?attr/zzSurface">
            <LinearLayout android:id="@+id/layout_challenge_settings" android:layout_width="1dp" android:layout_height="1dp"><TextView android:id="@+id/tv_challenge_summary" android:layout_width="1dp" android:layout_height="1dp" /></LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:cardBackgroundColor="?attr/zzSurface">
            <LinearLayout android:id="@+id/layout_unlock_settings" android:layout_width="1dp" android:layout_height="1dp"><TextView android:id="@+id/tv_unlock_summary" android:layout_width="1dp" android:layout_height="1dp" /></LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_marginBottom="8dp" android:text="闹钟列表" android:textColor="?attr/zzText" android:textSize="16sp" android:textStyle="bold" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_alarm_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:overScrollMode="never" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
            <Button android:id="@+id/btn_test_alarm" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:backgroundTint="?attr/zzSurface2" android:text="测试默认闹钟" android:textAllCaps="false" android:textColor="?attr/zzText" android:textSize="15sp" android:textStyle="bold" />
            <Button android:id="@+id/btn_add_alarm" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_marginStart="5dp" android:backgroundTint="?attr/zzAccent" android:text="新增闹钟" android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <Button android:id="@+id/btn_bookmarked_poems" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:backgroundTint="?attr/zzSurface2" android:text="收藏本" android:textAllCaps="false" android:textColor="?attr/zzMuted" android:textSize="13sp" android:textStyle="bold" />
            <Button android:id="@+id/btn_custom_question_bank" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="5dp" android:backgroundTint="?attr/zzSurface2" android:text="自定义题库" android:textAllCaps="false" android:textColor="?attr/zzMuted" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <Button android:id="@+id/btn_bookmarked_words" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <Button android:id="@+id/btn_bookmarked_clozes" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
