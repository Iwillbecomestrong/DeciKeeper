<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F4"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="84dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="起床闹钟"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#233128" />

            <Button
                android:id="@+id/btn_emergency_whitelist"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="应急应用"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#52655A"
                android:backgroundTint="#E6ECE7"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="手机放身边，二维码放远处；听得到，也避免躺着直接按掉。"
            android:textSize="13sp"
            android:textColor="#6B786F"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="14dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:id="@+id/layout_snooze_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="15dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="闹钟默认设置"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#344139" />

                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_snooze_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="双阶段 · 再响10min×2"
                    android:textSize="12sp"
                    android:textColor="#6D7971"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="#8A958D" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/card_alarm_keepalive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#EEF3EF">

            <LinearLayout
                android:id="@+id/layout_alarm_keepalive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="15dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="闹钟保活"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#52655A" />

                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_keepalive_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="防睡眠冻结 / 后台保活"
                    android:textSize="12sp"
                    android:textColor="#6D7971"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="#8A958D" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:id="@+id/layout_challenge_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="默认挑战数量"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#344139" />

                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_challenge_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="数学2 / 诗词3 / 单词10"
                    android:textSize="12sp"
                    android:textColor="#6D7971"
                    android:layout_marginEnd="5dp"
                    android:maxLines="1" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="22sp" android:textColor="#8A958D" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:id="@+id/layout_unlock_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="默认解锁方式"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#344139" />

                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_unlock_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="单次"
                    android:textSize="12sp"
                    android:textColor="#6D7971"
                    android:layout_marginEnd="5dp"
                    android:maxLines="1" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="22sp" android:textColor="#8A958D" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="闹钟列表"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#344139"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_alarm_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btn_add_alarm"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="新增闹钟"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#78917D" />

            <Button
                android:id="@+id/btn_test_alarm"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="测试闹钟"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#526057"
                android:backgroundTint="#E3E9E4" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btn_bookmarked_poems"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="收藏本"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#526057"
                android:backgroundTint="#E9EDE9" />

            <Button
                android:id="@+id/btn_bookmarked_words"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="收藏的单词"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="#526057"
                android:backgroundTint="#E9EDE9" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_bookmarked_clozes"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:text="收藏的选词填空"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="#526057"
            android:backgroundTint="#E9EDE9" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
