<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_dual_app"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="7dp"
    android:paddingVertical="7dp"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_dual_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/zzText"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_dual_app_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="?attr/zzMuted"
            android:textSize="8sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_dual_app_arrow"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_zz_badge"
        android:gravity="center"
        android:textColor="?attr/zzAccentStrong"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
