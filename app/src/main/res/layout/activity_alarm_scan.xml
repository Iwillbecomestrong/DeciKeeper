<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/zzPageBg"
    android:keepScreenOn="true">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="?attr/zzSurface">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="扫码关闭闹钟"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/zzText" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="将二维码置于框内，保持手机稳定，适当调整距离"
            android:textSize="14sp"
            android:textColor="?attr/zzMuted"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_scan_torch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="96dp"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <ImageButton
            android:id="@+id/btn_torch"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_torch"
            android:background="@drawable/btn_torch_bg"
            android:contentDescription="补光/手电筒"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/tv_torch_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="轻触照亮"
            android:textSize="12sp"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_scan_cancel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_margin="24dp"
        android:text="返回挑战"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/zzText"
        android:backgroundTint="?attr/zzSurfaceStrong" />
</FrameLayout>
