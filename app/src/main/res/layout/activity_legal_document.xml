<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/zzPageBg"
    android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <ImageView
            android:id="@+id/btn_legal_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginBottom="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:padding="6dp"
            app:tint="?attr/zzText"
            android:src="@drawable/ic_back_arrow" />
        <TextView android:id="@+id/tv_legal_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/zzText" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_legal_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_marginBottom="14dp" android:textColor="?attr/zzSubtle" android:textSize="11sp" />
        <TextView android:id="@+id/tv_legal_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_zz_card" android:backgroundTint="?attr/zzSurface" android:lineSpacingExtra="5dp" android:padding="16dp" android:textColor="?attr/zzText" android:textIsSelectable="true" android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
