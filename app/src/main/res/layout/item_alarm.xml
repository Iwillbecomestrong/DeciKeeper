<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_alarm_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/zzSurface"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/tv_alarm_time" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="07:30" android:textColor="?attr/zzText" android:textSize="25sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_system_backup_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:text="备份" android:textColor="?attr/zzMuted" android:textSize="11sp" />
            <ImageButton android:id="@+id/btn_system_backup_help" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="5dp" android:background="@drawable/bg_zz_pill" android:backgroundTint="?attr/zzInfoSoft" android:contentDescription="备份说明" android:padding="5dp" android:scaleType="centerInside" android:src="@android:drawable/ic_menu_help" app:tint="?attr/zzInfo" />
            <Button android:id="@+id/btn_system_backup_action" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginEnd="5dp" android:backgroundTint="?attr/zzInfoSoft" android:minHeight="0dp" android:minWidth="0dp" android:paddingHorizontal="9dp" android:text="同步" android:textAllCaps="false" android:textColor="?attr/zzInfo" android:textSize="10sp" />
            <ImageButton android:id="@+id/btn_delete_alarm" android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/bg_zz_pill" android:backgroundTint="?attr/zzSurface2" android:contentDescription="删除" android:padding="5dp" android:scaleType="centerInside" android:src="@android:drawable/ic_menu_delete" app:tint="?attr/zzMuted" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/tv_alarm_days" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="周一 周二 周三" android:textColor="?attr/zzMuted" android:textSize="12sp" />
            <Switch android:id="@+id/switch_alarm_item" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="end" android:orientation="horizontal">
            <Button android:id="@+id/btn_challenge_alarm" android:layout_width="wrap_content" android:layout_height="32dp" android:backgroundTint="?attr/zzAccent" android:minHeight="0dp" android:minWidth="0dp" android:paddingHorizontal="10dp" android:text="挑战" android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="10sp" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
