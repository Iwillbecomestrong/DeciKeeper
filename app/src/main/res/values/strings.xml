<resources>
    <string name="app_name">决定守护</string>
    <string name="accessibility_description">决定守护核心服务，用于保护您的自律状态并防止应用被意外卸载。请保持开启以确保保护生效。</string>

    <!-- Anti-Uninstall Warning -->
    <string name="anti_uninstall_title">防卸载保护</string>
    <string name="anti_uninstall_message">检测到尝试卸载、停止决定守护或关闭无障碍服务的行为，已自动拦截保护。\n\n如需手动操作，请先在 App 内关闭防卸载保护。</string>
    <string name="btn_got_it">我知道了</string>
    <string name="btn_back">返回桌面</string>

    <!-- Privacy Space Guard (TASK-02: 第二套独立开关 UI 文案, 仅新增, 不删旧) -->
    <string name="privacy_space_guard_title">隐私空间拦截</string>
    <string name="privacy_space_guard_summary">阻止将决定守护添加进隐私空间</string>
    <string name="privacy_space_guard_status_off">已关闭</string>
    <string name="privacy_space_guard_status_active">已生效</string>
    <string name="privacy_space_guard_status_pending">次日生效，当前仍拦截</string>
    <string name="privacy_space_guard_enable_guide_title">🔒 开启隐私空间拦截</string>
    <string name="privacy_space_guard_enable_guide_body">「隐私空间拦截」通过无障碍服务监控「添加应用」页面，阻止决定守护被移入隐私空间。\n\n请先在系统中开启决定守护的无障碍服务后再开启本开关。</string>
    <string name="privacy_space_guard_enable_guide_open_a11y">前往开启无障碍</string>
    <string name="privacy_space_guard_toast_enabled">✅ 隐私空间拦截已开启</string>
    <string name="privacy_space_guard_toast_pending">⏳ 已申请关闭隐私空间拦截（明日生效，可与防卸载同次提交）</string>
    <string name="privacy_space_guard_toast_adaptation_off">✅ 适应期内，隐私空间拦截已立即关闭</string>
    <string name="privacy_space_guard_toast_need_a11y">⚠️ 请先开启无障碍服务</string>
    <string name="a11y_service_not_ready_toast">⚠️ 无障碍服务待关闭或未开启，请先开启无障碍服务</string>

    <!-- Settings protection help -->
    <string name="settings_help_accessibility_title">无障碍服务说明</string>
    <string name="settings_help_accessibility_message">这是下方增强功能的前置服务。关闭无障碍服务时，需先处理防卸载增强的关闭流程。</string>
    <string name="settings_help_permission_title">小窗可见性识别与防关权限保护说明</string>
    <string name="settings_help_permission_message">开启后，决定守护会增强小窗可见性识别，并在已识别的系统页面保护关键权限不被立即关闭。不同设备的小窗呈现方式不同，效果会随系统版本变化。</string>
    <string name="settings_help_privacy_title">隐私空间保护说明</string>
    <string name="settings_help_privacy_message">部分设备存在独立空间的添加应用入口，可能让保护链失效。此项是兼容性保护，只覆盖当前已适配的可见入口。</string>
    <string name="settings_help_anti_uninstall_title">防卸载增强说明</string>
    <string name="settings_help_anti_uninstall_message">用于降低从系统入口直接卸载、强行停止或关闭关键服务的即时绕过概率。语言切换或服务重连时，可能短暂显示初始化/预热界面。</string>
    <string name="settings_help_alarm_power_off_title">闹钟防关机保护说明</string>
    <string name="settings_help_alarm_power_off_message">仅在闹钟挑战期间工作。开启前需要无障碍、悬浮窗、通知和锁屏显示等前置条件。</string>

    <!-- Lock Penalty Dialog -->
    <string name="penalty_dialog_title">决定守护强制干预</string>
    <string name="penalty_reason_consecutive">非休息/空档期内，黑名单或非时间窗应用连续触发达到3次要进行一次强制锁机了</string>
    <string name="penalty_reason_tolerance">本时段所有的休息时间（含借用）都用完了，现在点击黑名单软件就要开始强制锁机了</string>
    <string name="penalty_message_template">拦截到黑名单应用：%1$s\n\n触发原因：%2$s\n\n已进入强制锁机冷静期\n\n提示：下次请先点击「回到桌面」关闭小窗或应用，避免再次触发锁机</string>

