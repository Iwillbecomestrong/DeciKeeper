    <string name="app_name">决定守护</string>
    <string name="accessibility_description">决定守护核心服务，用于保护您的自律状态并防止应用被意外卸载。请保持开启以确保保护生效。</string>

    <!-- Anti-Uninstall Warning -->
    <string name="anti_uninstall_title">防卸载保护</string>
    <string name="anti_uninstall_message">检测到尝试卸载、停止决定守护或关闭无障碍服务的行为，已自动拦截保护。\n\n如需手动操作，请先在 App 内关闭防卸载保护。</string>
